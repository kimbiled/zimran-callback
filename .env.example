# Server-only variables; never commit .env.local or use NEXT_PUBLIC_ for credentials.
DATABASE_URL=

# One OpenAI project key for GPT-Live and direct judge/debrief/text requests.
OPENAI_API_KEY=
GPT_LIVE_MODEL=gpt-live-1

# auto prefers OPENAI_API_KEY, otherwise Gateway/OIDC; pin openai or gateway if needed.
AI_PROVIDER=auto
AI_GATEWAY_API_KEY=
JUDGE_MODEL=openai/gpt-4.1-mini
DEBRIEF_MODEL=openai/gpt-4.1-mini
# Used once if the debrief model errors (unknown id, rejected parameter, timeout).
DEBRIEF_FALLBACK_MODEL=openai/gpt-4.1
BUYER_MODEL=openai/gpt-4.1-mini
AI_DISABLED=0

# Protected live eval, one-request probe and feedback export. Authorization: Bearer header.
EVAL_KEY=
FREE_CALL_LIMIT=3
MAX_CALL_SECONDS=300
STRIPE_SECRET_KEY=

# Max accepted call starts / voice sessions per IP per hour (default 30).
RATE_LIMIT_PER_HOUR=
