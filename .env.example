# Callback — environment variables. Everything is optional: the app runs without any of them,
# but production should set DATABASE_URL.

# Neon Postgres (database "callback"). Without it the app uses in-memory storage (local dev only).
DATABASE_URL=

# ElevenLabs voice agent. Defaults to the agent created for this project (public, no key needed).
ELEVENLABS_AGENT_ID=agent_5501m7chgm92fe7rbwpaw8behtws
# Optional: with a key the server hands out signed URLs, so the agent can be made private.
ELEVENLABS_API_KEY=

# GPT-Live (OpenAI) voice. With a key, voice calls run on GPT-Live over WebRTC; the key stays
# on the server (POST /api/voice/session forwards the browser's SDP offer). Text mode and any
# GPT-Live connection failure fall back to the ElevenLabs agent. Needs a paid API tier.
OPENAI_API_KEY=
GPT_LIVE_MODEL=gpt-live-1
# Set to "elevenlabs" to keep voice calls on ElevenLabs even with OPENAI_API_KEY set.
VOICE_PROVIDER=

# Judge + debrief models via Vercel AI Gateway. On Vercel, OIDC auth is automatic.
# Locally, create a key at vercel.com/ai-gateway and set it here.
AI_GATEWAY_API_KEY=
JUDGE_MODEL=openai/gpt-4.1-mini
DEBRIEF_MODEL=openai/gpt-4.1

# Free plan and call limits
FREE_CALL_LIMIT=3
MAX_CALL_SECONDS=300

# Stripe test key. Without it, checkout runs in demo mode (plan activates, nothing is charged).
STRIPE_SECRET_KEY=

# Protects GET /api/eval?key=... (judge accuracy on the labeled set)
EVAL_KEY=
